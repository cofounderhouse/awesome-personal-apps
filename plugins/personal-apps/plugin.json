{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "personal-apps",
  "version": "1.0.6",
  "description": "Every personal app from the Cofounder House Library: one small AI app for one weekly task, each a skill. New apps arrive with each update.",
  "author": {
    "name": "Cofounder House",
    "email": "hello@cofounderhouse.com",
    "url": "https://cofounderhouse.com"
  },
  "homepage": "https://cofounderhouse.com/library",
  "repository": "https://github.com/cofounderhouse/awesome-personal-apps",
  "license": "MIT",
  "keywords": [
    "personal-app",
    "cofounder-house-library"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Personal apps",
        "shortDescription": "Every personal app from the Cofounder House Library in one plugin",
        "developerName": "Cofounder House",
        "category": "Productivity",
        "websiteURL": "https://cofounderhouse.com/library",
        "privacyPolicyURL": "https://cofounderhouse.com/privacy",
        "termsOfServiceURL": "https://cofounderhouse.com/terms",
        "defaultPrompt": [
          "Which personal app fits the file I'm about to share?"
        ]
      }
    }
  }
}
